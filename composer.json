{
    "name": "asignua/filament-notification-preferences",
    "description": "Let every Filament user choose which notifications they get and on which channels, without touching the notification classes.",
    "keywords": [
        "filament",
        "filament-plugin",
        "laravel",
        "notifications",
        "notification-preferences",
        "preferences",
        "unsubscribe"
    ],
    "homepage": "https://github.com/asignua/filament-notification-preferences",
    "support": {
        "issues": "https://github.com/asignua/filament-notification-preferences/issues",
        "source": "https://github.com/asignua/filament-notification-preferences"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Mykhailo Hladchenko",
            "email": "myhailo@hotmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Asignua\\FilamentNotificationPreferences\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Asignua\\FilamentNotificationPreferences\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Asignua\\FilamentNotificationPreferences\\NotificationPreferencesServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
